# get the package repository
function setRepository() {
  # make sure the SSH key (when set) is also used for the ls-remote and clone calls
  if [ -n "${GIT_SSH_KEY_PATH}" ] && [ -z "${GIT_SSH_COMMAND}" ]; then
    export GIT_SSH_COMMAND="ssh -i '${GIT_SSH_KEY_PATH}'"
  fi
  # nothing pushed yet
  VDM_REPOSITORY_STATUS='unchanged'
  export VDM_REPOSITORY_STATUS
  # change to git directory
  cd "${VDM_PACKAGE_GIT_DIR}" || return 22
  # check if the repository exist on our gitea instance
  local update_repo
  # shellcheck disable=SC2015
  if git ls-remote --exit-code --heads "git@${VDM_PACKAGE_URL}:${VDM_PACKAGE_OWNER}/${VDM_PACKAGE_REPO}.git" >/dev/null 2>&1; then
    getExistingRepository || return 23
    update_repo=true
  else
    setNewRepository || return 24
    update_repo=false
  fi
  # make sure we are in the correct dir and then remove all existing data
  cd "${VDM_PACKAGE_GIT_DIR}/${VDM_PACKAGE_REPO}" || return 25
  # remove any existing files and folders from repository
  rm -rf -- * || return 26
  # move all new files into repository
  setRepositoryNewFiles || return 27
  # check if we have changes
  if [[ "${update_repo}" == true && -z $(git status --porcelain) ]]; then
    _echo "[info] No changes found in (${VDM_PACKAGE_OWNER}/${VDM_PACKAGE_REPO}) repository"
  else
    # check if we must update or create repository
    if [[ "${update_repo}" == true ]]; then
      # make API call
      callGiteaAPI "tags" "${VDM_PACKAGE_OWNER}" "${VDM_PACKAGE_REPO}" "${VDM_PACKAGE_API}" "${VDM_PACKAGE_TOKEN}" || return 28
      # check if tag exists
      VDM_TAG_EXIST=$(echo "${VDM_API_BUCKET}" | jq -r --arg TAG "${VDM_PACKAGE_VERSION:-1.0.0}" 'any(.[]; .name == $TAG)')
      # set update message
      if $VDM_TAG_EXIST; then
        message="Update - ${VDM_PACKAGE_VERSION:-1.0.0}"
      else
        message="Update"
      fi
      # add user details
      setUserDetails
      # get the repository last tag
      makeGitCommit "${message}" "${VDM_PACKAGE_VERSION:-1.0.0}" "$VDM_TAG_EXIST" || return 28
      # give little notice of progress
      _echo "[info] Pushing changes to (${VDM_PACKAGE_OWNER}/${VDM_PACKAGE_REPO}) repository"
      # make a normal push update
      git push >/dev/null 2>&1 || return 30
      if ! $VDM_TAG_EXIST; then
        git push --tags >/dev/null 2>&1 || return 30
      fi
      # we pushed
      VDM_REPOSITORY_STATUS='pushed'
    else
      # create new repo
      setGitRepository || return 29
      # give little notice of progress
      _echo "[info] Pushing (TO CREATE) changes to (${VDM_PACKAGE_OWNER}/${VDM_PACKAGE_REPO}) repository"
      # push to creat the repository (if allowed)
      if [[ "${VDM_PACKAGE_REPO_BRANCH}" == 'default' ]]; then
        git push -u origin master >/dev/null 2>&1 || return 30
      else
        git push -u origin "${VDM_PACKAGE_REPO_BRANCH:-master}" >/dev/null 2>&1 || return 30
      fi
      git push --tags >/dev/null 2>&1 || return 30
      # we pushed
      VDM_REPOSITORY_STATUS='pushed'
    fi
  fi
  # success
  return 0
}

# get the existing repository
function getExistingRepository() {
  # little information of progress
  _echo "[info] Getting (${VDM_PACKAGE_OWNER}/${VDM_PACKAGE_REPO}) repository"
  if [[ "${VDM_PACKAGE_REPO_BRANCH}" == 'default' ]]; then
    # clone the existing repository
    git clone "git@${VDM_PACKAGE_URL}:${VDM_PACKAGE_OWNER}/${VDM_PACKAGE_REPO}.git" >/dev/null 2>&1 || return 23
  else
    # clone the existing repository
    git clone -b "${VDM_PACKAGE_REPO_BRANCH:-master}" "git@${VDM_PACKAGE_URL}:${VDM_PACKAGE_OWNER}/${VDM_PACKAGE_REPO}.git" >/dev/null 2>&1 || return 23
  fi
  # success
  return 0
}

# set the new repository
function setNewRepository() {
  # little information of progress
  _echo "[info] Creating (${VDM_PACKAGE_OWNER}/${VDM_PACKAGE_REPO}) folder"
  # check if the repository exist on our gitea instance
  mkdir -p "${VDM_PACKAGE_GIT_DIR}/${VDM_PACKAGE_REPO}" || return 24
  # success
  return 0
}

# set new git repository
function setGitRepository() {
  # little information of progress
  _echo "[info] Initializing the (${VDM_PACKAGE_OWNER}/${VDM_PACKAGE_REPO}) repository"
  # initialize the repository
  git init >/dev/null 2>&1 || return 29
  # add user details
  setUserDetails
  # add the first commit
  makeGitCommit "First Commit - ${VDM_PACKAGE_VERSION:-1.0.0}" "${VDM_PACKAGE_VERSION:-1.0.0}" >/dev/null 2>&1 || return 28
  # little information of progress
  _echo "[info] Adding remote branch to (${VDM_PACKAGE_OWNER}/${VDM_PACKAGE_REPO}) repository"
  # add the remote branch
  git remote add origin "git@${VDM_PACKAGE_URL}:${VDM_PACKAGE_OWNER}/${VDM_PACKAGE_REPO}.git" >/dev/null 2>&1 || return 29
  # Check if a specific branch is set and it is not 'default'
  if [ "${VDM_PACKAGE_REPO_BRANCH}" != "default" ]; then
    _echo "[info] Setting branch to ${VDM_PACKAGE_REPO_BRANCH}"
    git checkout -b "${VDM_PACKAGE_REPO_BRANCH}" >/dev/null 2>&1 || return 29
  fi
  #success
  return 0
}

# Set Git user details based on environment variables
function setUserDetails () {
  # Set Git author name
  if [ -n "${GIT_AUTHOR_NAME+x}" ]; then
    git config user.name "${GIT_AUTHOR_NAME}"
    _echo "[info] Git author name set to: ${GIT_AUTHOR_NAME}"
  fi

  # Set Git author email
  if [ -n "${GIT_AUTHOR_EMAIL+x}" ]; then
    git config user.email "${GIT_AUTHOR_EMAIL}"
    _echo "[info] Git author email set to: ${GIT_AUTHOR_EMAIL}"
  fi

  # Set signing key
  if [ -n "${GIT_SIGNING_KEY+x}" ]; then
    git config user.signingKey "${GIT_SIGNING_KEY}"
    _echo "[info] Git signing key set to: ${GIT_SIGNING_KEY}"
  fi

  # Set Git GPG sign
  if [ -n "${GIT_GPG_SIGN+x}" ]; then
    git config commit.gpgsign "${GIT_GPG_SIGN}"
    _echo "[info] Git GPG sign set to: ${GIT_GPG_SIGN}"
  fi

  # Set Git SSH key path
  if [ -n "${GIT_SSH_KEY_PATH+x}" ]; then
    git config core.sshCommand "ssh -i '${GIT_SSH_KEY_PATH}'"
    _echo "[info] Git SSH key path set to: ${GIT_SSH_KEY_PATH}"
  fi
}

# make the git commit
function makeGitCommit() {
  # add all (or remove)
  git add . >/dev/null 2>&1 || return 28
  # little information of progress
  _echo "[info] Committing (${1}) to (${VDM_PACKAGE_OWNER}/${VDM_PACKAGE_REPO}) repository"
  # set the commit message
  git commit -am"${1}" >/dev/null 2>&1 || return 28
  # check if the tag should be added
  if "${3:-false}"; then
    # little information of progress
    _echo "[info] TAG (${2}) in (${VDM_PACKAGE_OWNER}/${VDM_PACKAGE_REPO}) already exists"
  else
    # little information of progress
    _echo "[info] Adding TAG (${2}) to (${VDM_PACKAGE_OWNER}/${VDM_PACKAGE_REPO}) repository"
    # add the new tag
    git tag "${2}" >/dev/null 2>&1 || return 28
  fi
  # success
  return 0
}

# add all the new files to the repository
function setRepositoryNewFiles() {
  # make sure we have the package directory
  [ -d "${VDM_PACKAGE_DIR}" ] || return 27
  # copy the files when we must keep them, else move them
  if _is_true "${VDM_KEEP_FILES}"; then
    # little information of progress
    _echo "[info] Copying new files into the (${VDM_PACKAGE_OWNER}/${VDM_PACKAGE_REPO}) directory"
    cp -a "${VDM_PACKAGE_DIR:?}/." "${VDM_PACKAGE_GIT_DIR}/${VDM_PACKAGE_REPO}" >/dev/null 2>&1 || return 27
  else
    # little information of progress
    _echo "[info] Moving new files into the (${VDM_PACKAGE_OWNER}/${VDM_PACKAGE_REPO}) directory"
    _echo "[info] Removing the ${VDM_PACKAGE_DIR:?} directory"
    mv "${VDM_PACKAGE_DIR:?}/"* "${VDM_PACKAGE_GIT_DIR}/${VDM_PACKAGE_REPO}" >/dev/null 2>&1 &&
      rm -rf "${VDM_PACKAGE_DIR:?}" >/dev/null 2>&1 ||
      return 27
  fi
  # success
  return 0
}

# gives us a unique file name for any url
function getUniqueFileName() {
  local url="$1"
  local hash
  hash=$(echo "$url" | sha256sum | awk '{print $1}')
  echo "${hash:0:10}"
}

# Get the version from the current directory
function _xml_version() {
  local version=""
  local shortest_depth=100
  local file
  local v
  local depth

  # Find XML files excluding config.xml, access.xml, default.xml
  while IFS= read -r file; do
    # Ensure file does not match exclusions
    case "$file" in
      *config.xml|*access.xml|*default.xml) continue ;;
    esac

    # Ensure it's an extension XML (check if it has a <extension> root tag anywhere)
    if ! grep -iq '^[[:space:]]*<extension[[:space:]>]' "$file"; then
      continue
    fi

    # Extract version if present in XML
    v=$(sed -n 's|.*<version>\(.*\)</version>.*|\1|p' "$file" | head -n1)

    # Skip if no version found
    [[ -z "$v" ]] && continue

    # Determine folder depth (count slashes)
    depth=$(tr -cd '/' <<< "$file" | wc -c)

    # Choose the file with the shortest path (highest in folder stack)
    if (( depth < shortest_depth )); then
      shortest_depth=$depth
      version=$v

      # Since we want the highest-up file, and this is the shallowest so far,
      # we can break early if it's at root level (depth 1)
      (( depth <= 1 )) && break
    fi

  done < <(find . -type f -iname '*.xml')

  # Return failure if no version is found
  if [[ -z "$version" ]]; then
    return 14
  fi

  # Ensure version starts with 'v'
  [[ $version != v* ]] && version="v${version}"

  # Export version
  export VDM_ZIP_VERSION="$version"

  return 0
}

# build the package zip file (Joomla installable package)
function setPackageZip() {
  # we need the zip command for this
  command -v zip >/dev/null 2>&1 || {
    echo >&2 "[error] We require zip to build the package zip file for $PROGRAM_NAME v${PROGRAM_V}, but it's not installed."
    return 31
  }
  # little information of progress
  _echo "[info] Building the Package Zip..."
  # set the zip directory (default: <main-dir>/packages)
  VDM_PACKAGE_ZIP_DIR="${VDM_PACKAGE_ZIP_DIR:-${VDM_MAIN_DIR}/packages}"
  # set the zip name (default: <package_name>_<tag>.zip)
  VDM_PACKAGE_ZIP_NAME="${VDM_PACKAGE_ZIP_NAME:-${VDM_PACKAGE_NAME,,}_${VDM_PACKAGE_VERSION:-1.0.0}.zip}"
  # make sure the name is safe to use as a file name
  VDM_PACKAGE_ZIP_NAME="$(_safe_name "${VDM_PACKAGE_ZIP_NAME}")" || return 31
  # make sure we have the zip extension
  [[ "${VDM_PACKAGE_ZIP_NAME}" == *.zip ]] || VDM_PACKAGE_ZIP_NAME="${VDM_PACKAGE_ZIP_NAME}.zip"
  # set the zip path
  VDM_PACKAGE_ZIP_PATH="${VDM_PACKAGE_ZIP_DIR}/${VDM_PACKAGE_ZIP_NAME}"
  # make sure the zip directory exists
  mkdir -p "${VDM_PACKAGE_ZIP_DIR}" || return 31
  # always remove the previous zip file (if found)
  rm -f "${VDM_PACKAGE_ZIP_PATH:?}"
  # build the zip from inside the package directory (so the paths are relative)
  (cd "${VDM_PACKAGE_DIR}" && zip -qr -X "${VDM_PACKAGE_ZIP_PATH}" .) || return 31
  # get the checksum
  VDM_PACKAGE_ZIP_SHA256=$(sha256sum "${VDM_PACKAGE_ZIP_PATH}" | awk '{print $1}') || return 31
  # write the checksum file (in the format sha256sum -c expects)
  VDM_PACKAGE_ZIP_SHA256_FILE="${VDM_PACKAGE_ZIP_PATH%.zip}.sha256"
  echo "${VDM_PACKAGE_ZIP_SHA256}  ${VDM_PACKAGE_ZIP_NAME}" >"${VDM_PACKAGE_ZIP_SHA256_FILE}" || return 31
  # make globally available
  export VDM_PACKAGE_ZIP_DIR
  export VDM_PACKAGE_ZIP_NAME
  export VDM_PACKAGE_ZIP_PATH
  export VDM_PACKAGE_ZIP_SHA256
  export VDM_PACKAGE_ZIP_SHA256_FILE
  # little information of progress
  _echo "[info] Package zip created (${VDM_PACKAGE_ZIP_PATH})"
  # success
  return 0
}

# write the build results (manifest file and key=value outputs)
function setOutputs() {
  # the output file (GitHub Actions sets GITHUB_OUTPUT)
  local output_file="${VDM_OUTPUT_FILE:-${GITHUB_OUTPUT:-}}"
  local tag
  local version
  local pushed=false
  local status='disabled'
  local package_dir=''
  local package_xml=''
  local repository_url=''
  local extensions='[]'
  # set the version (with and without the v prefix)
  tag="${VDM_PACKAGE_VERSION:-1.0.0}"
  version="${tag/#v/}"
  # did we push to the git repository (pushed, unchanged or disabled)
  if _is_true "${VDM_PACKAGE_PUSH}"; then
    status="${VDM_REPOSITORY_STATUS:-unchanged}"
    [ "${status}" = 'pushed' ] && pushed=true
  fi
  # the package files are only available when kept
  if _is_true "${VDM_KEEP_FILES}"; then
    package_dir="${VDM_PACKAGE_DIR}"
    package_xml="${VDM_PACKAGE_XML}"
  fi
  # the repository url
  if [ -n "${VDM_PACKAGE_URL}" ] && [ -n "${VDM_PACKAGE_OWNER}" ] && [ -n "${VDM_PACKAGE_REPO}" ]; then
    repository_url="https://${VDM_PACKAGE_URL}/${VDM_PACKAGE_OWNER}/${VDM_PACKAGE_REPO}"
  fi
  # get the extensions list
  if [ -s "${VDM_FILES_JSON}" ]; then
    extensions=$(jq -sc '.' "${VDM_FILES_JSON}") || extensions='[]'
  fi
  # write the manifest file (next to the zip file)
  if [ -n "${VDM_PACKAGE_ZIP_PATH}" ]; then
    VDM_PACKAGE_MANIFEST="${VDM_PACKAGE_ZIP_PATH%.zip}.json"
    export VDM_PACKAGE_MANIFEST
    # little information of progress
    _echo "[info] Writing the package manifest (${VDM_PACKAGE_MANIFEST})..."
    jq -n \
      --arg packager "${PROGRAM_NAME} v${PROGRAM_VERSION}" \
      --arg created "$(TZ=":ZULU" date +"%Y-%m-%dT%H:%M:%SZ")" \
      --arg name "$(_human_name "${VDM_NAME}")" \
      --arg package_name "${VDM_PACKAGE_NAME}" \
      --arg code_name "${VDM_CODE_NAME}" \
      --arg version "${version}" \
      --arg tag "${tag}" \
      --arg min_joomla "${VDM_MIN_JOOMLA_VERSION}" \
      --arg max_joomla "${VDM_MAX_JOOMLA_VERSION}" \
      --arg zip "${VDM_PACKAGE_ZIP_NAME}" \
      --arg sha256 "${VDM_PACKAGE_ZIP_SHA256}" \
      --arg owner "${VDM_PACKAGE_OWNER}" \
      --arg repo "${VDM_PACKAGE_REPO}" \
      --arg branch "${VDM_PACKAGE_REPO_BRANCH}" \
      --arg url "${repository_url}" \
      --arg status "${status}" \
      --argjson pushed "${pushed}" \
      --argjson extensions "${extensions}" \
      '{
        packager: $packager,
        created: $created,
        package: {
          name: $name,
          package_name: $package_name,
          code_name: $code_name,
          version: $version,
          tag: $tag,
          min_joomla_version: $min_joomla,
          max_joomla_version: $max_joomla
        },
        zip: {name: $zip, sha256: $sha256},
        repository: {owner: $owner, repo: $repo, branch: $branch, url: $url, pushed: $pushed, status: $status},
        extensions: $extensions
      }' >"${VDM_PACKAGE_MANIFEST}" || {
      echo >&2 "[error] We could not write the package manifest (${VDM_PACKAGE_MANIFEST})."
      unset VDM_PACKAGE_MANIFEST
    }
  fi
  # we only write the outputs when we have an output file
  [ -n "${output_file}" ] || return 0
  # little information of progress
  _echo "[info] Writing the outputs to (${output_file})..."
  {
    _output 'name' "$(_human_name "${VDM_NAME}")"
    _output 'package-name' "${VDM_PACKAGE_NAME}"
    _output 'code-name' "${VDM_CODE_NAME}"
    _output 'version' "${version}"
    _output 'tag' "${tag}"
    _output 'package-dir' "${package_dir}"
    _output 'package-xml' "${package_xml}"
    _output 'package-zip' "${VDM_PACKAGE_ZIP_PATH}"
    _output 'package-zip-name' "${VDM_PACKAGE_ZIP_NAME}"
    _output 'package-zip-dir' "${VDM_PACKAGE_ZIP_DIR}"
    _output 'package-sha256' "${VDM_PACKAGE_ZIP_SHA256}"
    _output 'package-sha256-file' "${VDM_PACKAGE_ZIP_SHA256_FILE}"
    _output 'package-manifest' "${VDM_PACKAGE_MANIFEST}"
    _output 'repository-owner' "${VDM_PACKAGE_OWNER}"
    _output 'repository-repo' "${VDM_PACKAGE_REPO}"
    _output 'repository-branch' "${VDM_PACKAGE_REPO_BRANCH}"
    _output 'repository-url' "${repository_url}"
    _output 'pushed' "${pushed}"
    _output 'repository-status' "${status}"
    _output 'extensions' "${extensions}"
  } >>"${output_file}" || {
    echo >&2 "[error] We could not write the outputs to (${output_file})."
    return 32
  }
  # success
  return 0
}

# write one output value (GitHub Actions multiline format)
function _output() {
  local key="${1}"
  local value="${2}"
  local delimiter="octojpack_${RANDOM}${RANDOM}${RANDOM}"
  printf '%s<<%s\n%s\n%s\n' "${key}" "${delimiter}" "${value}" "${delimiter}"
}

# get the human readable name (resolves the language constants of the packager language)
function _human_name() {
  local value="${1}"
  if [ -n "${value}" ] && [ -n "${VDM_LANG_STRINGS[${value}]+x}" ]; then
    echo "${VDM_LANG_STRINGS[${value}]}"
  else
    echo "${value}"
  fi
}

# check that a value is a valid owner, repository or branch name (safe in paths and git urls)
function _valid_name() {
  [[ "${1}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] && [ "${1}" != '..' ]
}

# make a value safe to use as a file or folder name (no path separators, never . or ..)
function _safe_name() {
  local value="${1}"
  value="${value//\//_}"
  value="${value//\\/_}"
  value="${value//[[:space:]]/_}"
  if [ -z "${value}" ] || [ "${value}" = '.' ] || [ "${value}" = '..' ]; then
    echo >&2 "[error] The name (${1}) can not be used as a file or folder name."
    return 12
  fi
  echo "${value}"
}

# make a path absolute (relative to the directory the program was started in)
function _abs_path() {
  case "${1}" in
  '' | /*)
    printf '%s' "${1}"
    ;;
  *)
    printf '%s/%s' "${VDM_START_DIR}" "${1}"
    ;;
  esac
}

# set an option given on the command line (and remember it, so the env files can not override it)
# the fourth argument (path) makes a relative path absolute, since the program changes directory while working
function setCliOption() {
  local name="${1}"
  local value="${2}"
  local option="${3}"
  local kind="${4:-}"
  if [ -z "${value}" ]; then
    echo "[error] \"${option}\" requires a non-empty option argument."
    exit 17
  fi
  if [ "${kind}" = 'path' ] && ! [[ "${value}" =~ ^https?: ]]; then
    value="$(_abs_path "${value}")"
  fi
  declare -g "${name}=${value}"
  CLI_OPTIONS+=("${name}=${value}")
}

# re-apply the options given on the command line (they take precedence over the env files)
function applyCliOptions() {
  local option
  for option in "${CLI_OPTIONS[@]}"; do
    declare -g "${option%%=*}=${option#*=}"
  done
}

# check if a value is true (1, true, yes, on, y)
function _is_true() {
  case "${1,,}" in
  1 | true | yes | on | y)
    return 0
    ;;
  *)
    return 1
    ;;
  esac
}

# give the echo messages
# only if not set to be quiet
function _echo() {
  if (("$QUIET" == 0)); then
    echo "$1"
  fi
}

# Unzip a zip file
function _unzip() {
  # Set some locals.
  local zip_name="${1}"
  local folder_name="${2}"

  # Unzip the contents of the `zip_name` file to the specified `folder_name`.
  # Use process substitution to pass the output of `unzip` to `cat`.
  if cat < <(unzip "${VDM_PACKAGE_SRC_DIR}/$zip_name" -d "${VDM_PACKAGE_GIT_DIR}/$folder_name") >/dev/null 2>&1; then
    _echo "[info] Successfully unzipped the package ($zip_name)"
    return 0
  fi

  # Return 1 if the unzip operation was unsuccessful.
  return 1
}

# uninstalls the octojpack program.
function runUninstall() {
  # now remove the script
  if [ -f "/usr/local/bin/${PROGRAM_CODE}" ]; then
    sudo rm -f "/usr/local/bin/${PROGRAM_CODE}"
    echo "[info] ${PROGRAM_NAME} v${PROGRAM_VERSION} has been completely uninstalled."
  else
    echo "[info] ${PROGRAM_NAME} v${PROGRAM_VERSION} is not installed."
  fi
}

# check if we have project overrides for the environment variables
function getProjectEnvironment() {
  # load the config data
  VDM_CONFIG_DATA=$(cat "$VDM_PACKAGE_CONF_FILE")
  # make sure we have package details
  if [[ "${VDM_CONFIG_DATA}" =~ '"package"' ]] && [[ "${VDM_CONFIG_DATA}" =~ '"files"' ]]; then
    # little information of progress
    _echo "[info] Loading the environment variables..."
    # make configuration globally available
    export VDM_CONFIG_DATA
    # get package code_name
    getConfigValue 'VDM_CODE_NAME' '.package.code_name'
    # the tmp path to the env of this project
    tmp_path="/home/$USER/.config/${PROGRAM_CODE}/.${VDM_CODE_NAME}"
    # shellcheck disable=SC1090
    [ -f "${tmp_path}" ] && source "${tmp_path}"
    # the command line options take precedence
    applyCliOptions
    # clear this tmp out
    unset tmp_path
    # success
    return 0
  else
    # failed
    return 17
  fi
}

# updates the octojpack program to the latest version.
function runUpdate() {
  # remove the current version
  if [ -f "/usr/local/bin/${PROGRAM_CODE}" ]; then
    # just backup in case of failure
    sudo mv "/usr/local/bin/${PROGRAM_CODE}" "/usr/local/bin/${PROGRAM_CODE}.bak"
  fi
  # pull the latest version. Master is always the latest
  if sudo curl --fail -L "https://raw.githubusercontent.com/octoleo/${PROGRAM_CODE}/refs/heads/${branch:-master}/src/${PROGRAM_CODE}" -o "/usr/local/bin/${PROGRAM_CODE}" 2>/dev/null; then
    # give success message
    echo "[success] Update was successful."
    # do we have a backup
    if [ -f "/usr/local/bin/${PROGRAM_CODE}.bak" ]; then
      # lets remove it now
      sudo rm -f "/usr/local/bin/${PROGRAM_CODE}.bak"
    fi
  else
    # show the error
    echo >&2 "[error] Update failed! Please try again later."
    # do we have a backup
    if [ -f "/usr/local/bin/${PROGRAM_CODE}.bak" ]; then
      # move backup back
      sudo mv "/usr/local/bin/${PROGRAM_CODE}.bak" "/usr/local/bin/${PROGRAM_CODE}"
    fi
  fi
  # always set the permission again if we have a file
  if [ -f "/usr/local/bin/${PROGRAM_CODE}" ]; then
    # the we make sure its executable
    sudo chmod +x "/usr/local/bin/${PROGRAM_CODE}"
  fi
  # always exit so the new script can load
  exit 0
}

